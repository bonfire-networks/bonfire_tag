{#case Bonfire.Common.Settings.get([:ui, :show_trending_tags, :disabled], nil,
    context: @__context__,
    name: l("Hide Trending Tags"),
    description: l("Hide the trending tags widget.")
  ) != true and
    {Bonfire.Common.Settings.get([:ui, :show_trending_tags, :for_last_x_days], 30,
       context: @__context__,
       name: l("Trending Tags Time Period"),
       description: l("Number of days to include when calculating trending tags.")
     ),
     Bonfire.Common.Settings.get([:ui, :show_trending_tags, :limit], 10,
       context: @__context__,
       name: l("Trending Tags Limit"),
       description: l("Maximum number of trending tags to display.")
     )}}
  {#match {for_last_x_days, limit}}
    {#case Bonfire.Tag.list_trending(
        for_last_x_days,
        limit
      )}
      {#match trending when is_list(trending)}
        {#case Vocabulary.preset(:trending_tags, @__context__)}
          {#match vocab}
            <Bonfire.UI.Common.WidgetBlockLive
              widget_title={@widget_title || Vocabulary.phrase(vocab, :title)}
              reset_cache_event="Bonfire.Tag.Web.WidgetTagsLive:reset_trending"
              reset_cache_values={%{for_last_x_days: for_last_x_days, limit: limit}}
              can_reset={@always_show_reset_btn || Bonfire.Boundaries.can?(@__context__, :tag, :instance_wide)}
            >
              {!-- each tag with its use count in the period --}
              <ul class="flex flex-wrap gap-1.5" data-role="widget-body">
                {#if trending != []}
                  {#for %{tag: tag} = tagged <- trending}
                    {#if e(tag, :table_id, nil) == "7HASHTAG1SPART0FF01KS0N0MY" or
                        Types.object_type(tag) == Bonfire.Tag.Hashtag}
                      {!-- FIXME ^ should just use Types.object_type ? --}
                      <li data-role="hashtag">
                        <LinkLive
                          class="widget-chip relative touch-target-expanded"
                          to={~p"/hashtag/" <> e(tag, :named, :name, "")}
                        >
                          <span class="touch-target-hit-area" aria-hidden="true" />
                          <span class="truncate">#{e(tag, :named, :name, nil)}</span>
                          <span class="text-subtle tabular-nums" aria-hidden="true">{e(tagged, :count, 0)}</span>
                          <span class="sr-only">{e(tagged, :count, 0)} {lp("activity", "activities", e(tagged, :count, 0))}</span>
                        </LinkLive>
                      </li>
                    {#else}
                      <li data-role="other">
                        <LinkLive
                          class="widget-chip relative touch-target-expanded"
                          to={"/tag/#{e(tag, :character, :username, nil) || e(tag, :id, nil) || path(tag)}"}
                        >
                          {!-- FIXME ^ should just use path(tag) ? --}
                          <span class="touch-target-hit-area" aria-hidden="true" />
                          <span class="truncate">{e(tag, :name, nil) || e(tag, :profile, :name, nil) || e(tag, :character, :username, nil) ||
                              e(tag, :named, :name, nil) || e(tag, :id, nil)}</span>
                          <span class="text-subtle tabular-nums" aria-hidden="true">{e(tagged, :count, 0)}</span>
                          <span class="sr-only">{e(tagged, :count, 0)} {lp("activity", "activities", e(tagged, :count, 0))}</span>
                        </LinkLive>
                      </li>
                    {/if}
                  {/for}
                {#else}
                  <li class="flex w-full flex-col items-center p-3 space-y-2 place-content-center">
                    <img src={Config.get([:ui, :theme, :instance_icon], nil)} class="w-12 h-full grayscale">
                    <span class="text-sm text-muted">{Vocabulary.phrase(vocab, :empty)}</span>
                  </li>
                {/if}
              </ul>
            </Bonfire.UI.Common.WidgetBlockLive>
        {/case}
      {#match _}
    {/case}
  {#match _}
{/case}